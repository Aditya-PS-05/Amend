# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Slack bot token (xoxb-...): api.slack.com/apps > your app > OAuth & Permissions. Bot scopes: channels:history, groups:history, chat:write
SLACK_BOT_TOKEN=
# Slack app-level token (xapp-...): Basic Information > App-Level Tokens, scope connections:write. Socket Mode ON, Interactivity ON, events message.channels (+ message.groups)
SLACK_APP_TOKEN=
# Optional: dedicated channel ID (C...). When set, every top-level message there is an instruction; otherwise use @Amend mentions in any channel the bot is invited to.
SLACK_CHANNEL_ID=

# HubSpot private app token (pat-...): Settings > Integrations > Private Apps. Scopes: crm.objects.deals.read, crm.objects.deals.write, crm.schemas.deals.read, crm.schemas.deals.write
HUBSPOT_TOKEN=

# Google OAuth client (type "Desktop app"): console.cloud.google.com > APIs & Services > Credentials. Enable the Gmail API; consent screen scope gmail.modify; add yourself as a test user
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Obtained by running: pnpm setup:gmail
GOOGLE_REFRESH_TOKEN=
# Optional From header for drafts, e.g. "Jane Doe <jane@example.com>" (must be your Gmail address or a verified alias)
GMAIL_FROM=

# Postgres connection string, e.g. postgres://user:pass@localhost:5432/amend (Neon/Supabase/local)
DATABASE_URL=

# Claude model used by the engine
AMEND_MODEL=claude-opus-5

# Port for the read-only ledger viewer (http://localhost:4000): threads, versions, ledger, conflicts, scoreboard
VIEWER_PORT=4000

# Optional Lemma tracing (https://docs.uselemma.ai). Tracing is off unless both LEMMA_API_KEY and LEMMA_PROJECT_ID are set
# Lemma API key (lma_...): Lemma dashboard > project settings. Server-side only
LEMMA_API_KEY=
# Lemma project id (proj_...): Lemma dashboard > project settings
LEMMA_PROJECT_ID=
# Optional release/version stamped on every trace (e.g. git SHA)
LEMMA_RELEASE=
# Optional: set to "false" to send only metadata/token usage, not prompts and model outputs
LEMMA_CAPTURE_CONTENT=true
# Optional: set to "off" to force tracing off even when Lemma keys are present
AMEND_TRACING=
# Optional: set to 1 to log Lemma SDK delivery details (trace starts, spans, send results)
LEMMA_DEBUG=

# Optional multi-workspace (OAuth) mode. When CLIENT_ID, CLIENT_SECRET and STATE_SECRET are all set, SLACK_BOT_TOKEN is ignored (see docs/SETUP.md > Multi-workspace install)
# Slack app Client ID: Basic Information > App Credentials
SLACK_CLIENT_ID=
# Slack app Client Secret: Basic Information > App Credentials
SLACK_CLIENT_SECRET=
# Any long random string used to sign OAuth state, e.g. `openssl rand -hex 32`
SLACK_STATE_SECRET=
# Local port for the install server (/slack/install, /slack/oauth_redirect); default 3000
SLACK_INSTALL_PORT=3000
# Public HTTPS redirect URL (tunnel to SLACK_INSTALL_PORT), must match the app's Redirect URLs, e.g. https://abc.trycloudflare.com/slack/oauth_redirect
SLACK_REDIRECT_URI=

# Watcher: how often to check HubSpot and Gmail for changes made outside Slack (ms). 0 disables it.
WATCH_INTERVAL_MS=20000
